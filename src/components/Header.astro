---
import ThemeToggle from './ThemeToggle.astro';
---

<header
  id="site-header"
  class="sticky top-0 z-50 bg-[var(--color-bg)]"
  style="height: 65px;"
>
  <nav class="max-w-6xl mx-auto px-4 sm:px-6 h-full flex items-center justify-between">
    <!-- Logo -->
    <a href="/" class="flex items-center no-underline" style="gap: 10px; margin-left: 4px;">
      <img
        src="/images/logo/512x512.png"
        alt="Cirkit Designer"
        style="width: 35px; height: 35px;"
      />
      <span style="font-family: 'Roboto', sans-serif; font-size: 26px; font-weight: 500; color: var(--color-text);">
        Cirkit Designer <span style="color: var(--color-text-secondary);">| Blog</span>
      </span>
    </a>

    <!-- Desktop nav -->
    <div class="hidden md:flex items-center" style="gap: 24px;">
      <a href="https://www.cirkitdesigner.com" style="font-family: 'Inter', sans-serif; font-size: 15px; font-weight: 500; color: var(--color-text-secondary);" class="hover:text-[var(--color-primary)] transition-colors no-underline">
        Home
      </a>
      <a href="https://app.cirkitdesigner.com" style="font-family: 'Inter', sans-serif; font-size: 15px; font-weight: 500; color: var(--color-text-secondary);" class="hover:text-[var(--color-primary)] transition-colors no-underline">
        IDE
      </a>
      <a href="https://learn.cirkitdesigner.com" style="font-family: 'Inter', sans-serif; font-size: 15px; font-weight: 500; color: var(--color-text-secondary);" class="hover:text-[var(--color-primary)] transition-colors no-underline">
        Docs
      </a>
      <a href="/" style="font-family: 'Inter', sans-serif; font-size: 15px; font-weight: 500; color: var(--color-primary);" class="no-underline">
        Blog
      </a>
      <ThemeToggle />
    </div>

    <!-- Mobile menu button -->
    <div class="flex items-center gap-2 md:hidden">
      <ThemeToggle />
      <button
        id="mobile-menu-btn"
        aria-label="Open menu"
        class="p-2 rounded-lg hover:bg-[var(--color-bg-alt)] transition-colors cursor-pointer"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden md:hidden bg-[var(--color-bg)]" style="box-shadow: 0 4px 4px -2px rgba(0,0,0,0.2);">
    <div class="px-4 py-3 flex flex-col gap-3">
      <a href="https://www.cirkitdesigner.com" style="font-family: 'Inter', sans-serif; font-size: 15px; font-weight: 500; color: var(--color-text-secondary);" class="hover:text-[var(--color-primary)] transition-colors no-underline">
        Home
      </a>
      <a href="https://app.cirkitdesigner.com" style="font-family: 'Inter', sans-serif; font-size: 15px; font-weight: 500; color: var(--color-text-secondary);" class="hover:text-[var(--color-primary)] transition-colors no-underline">
        IDE
      </a>
      <a href="https://learn.cirkitdesigner.com" style="font-family: 'Inter', sans-serif; font-size: 15px; font-weight: 500; color: var(--color-text-secondary);" class="hover:text-[var(--color-primary)] transition-colors no-underline">
        Docs
      </a>
      <a href="/" style="font-family: 'Inter', sans-serif; font-size: 15px; font-weight: 500; color: var(--color-primary);" class="no-underline">
        Blog
      </a>
    </div>
  </div>
</header>

<script>
  const header = document.getElementById('site-header')!;
  const menuBtn = document.getElementById('mobile-menu-btn')!;

  // Conditional shadow on scroll (matches app behavior)
  window.addEventListener('scroll', () => {
    if (window.scrollY > 0) {
      header.style.boxShadow = '0 0 0 1px rgb(220,220,220), 0 4px 4px -2px rgba(0,0,0,0.2)';
    } else {
      header.style.boxShadow = 'none';
    }
  });

  menuBtn.addEventListener('click', () => {
    document.getElementById('mobile-menu')!.classList.toggle('hidden');
  });
</script>
